{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "allowJs": true
  },
  "include": ["src/**/*", "server.ts", "src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules", "src/generated"]
}
